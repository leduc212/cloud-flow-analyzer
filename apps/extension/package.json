{
  "name": "@cfa/extension",
  "version": "1.0.0",
  "private": true,
  "description": "Cloud Flow Analyzer browser extension (Manifest V3).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vite build && vite build -c vite.content.config.ts",
    "dev": "vite build --mode development && vite build -c vite.content.config.ts --mode development",
    "icons": "node scripts/make-icons.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "test:e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "@cfa/core": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.56.1",
    "@types/chrome": "^0.3.0",
    "@types/node": "^22.20.4",
    "jsdom": "^30.1.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
