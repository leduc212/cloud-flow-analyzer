{
  "manifest_version": 3,
  "name": "Cloud Flow Analyzer",
  "short_name": "Flow Analyzer",
  "version": "1.0.0",
  "description": "Finds slow, wasteful and fragile patterns in Power Automate cloud flows, and shows the better pattern for each.",
  "homepage_url": "https://leduc212.github.io/cloud-flow-analyzer/",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Cloud Flow Analyzer",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["webRequest", "storage", "scripting"],
  "host_permissions": [
    "https://*.api.flow.microsoft.com/*",
    "https://*.api.powerplatform.com/*",
    "https://make.powerautomate.com/*",
    "https://make.preview.powerautomate.com/*",
    "https://make.powerapps.com/*",
    "https://make.preview.powerapps.com/*"
  ]
}
