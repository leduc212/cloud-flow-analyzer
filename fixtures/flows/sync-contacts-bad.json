{
  "name": "00000000-0000-4000-8000-000000000101",
  "type": "Microsoft.ProcessSimple/environments/flows",
  "properties": {
    "displayName": "Sync account contacts (before)",
    "state": "Started",
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": { "defaultValue": {}, "type": "Object" },
        "$authentication": { "defaultValue": {}, "type": "SecureObject" }
      },
      "triggers": {
        "When_a_row_is_added,_modified_or_deleted": {
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "SubscribeWebhookTrigger",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "subscriptionRequest/message": 3,
              "subscriptionRequest/entityname": "account",
              "subscriptionRequest/scope": 4
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      },
      "actions": {
        "Initialize_emails": {
          "runAfter": {},
          "type": "InitializeVariable",
          "inputs": { "variables": [{ "name": "emails", "type": "array" }] }
        },
        "Initialize_count": {
          "runAfter": { "Initialize_emails": ["Succeeded"] },
          "type": "InitializeVariable",
          "inputs": { "variables": [{ "name": "count", "type": "integer", "value": 0 }] }
        },
        "List_accounts": {
          "runAfter": { "Initialize_count": ["Succeeded"] },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": { "entityName": "accounts" },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Apply_to_each": {
          "foreach": "@outputs('List_accounts')?['body/value']",
          "actions": {
            "Get_primary_contact": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "GetItem",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "contacts",
                  "recordId": "@items('Apply_to_each')?['_primarycontactid_value']"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Append_email": {
              "runAfter": { "Get_primary_contact": ["Succeeded"] },
              "type": "AppendToArrayVariable",
              "inputs": {
                "name": "emails",
                "value": "@outputs('Get_primary_contact')?['body/emailaddress1']"
              }
            },
            "Increment_count": {
              "runAfter": { "Append_email": ["Succeeded"] },
              "type": "IncrementVariable",
              "inputs": { "name": "count", "value": 1 }
            },
            "Update_account": {
              "runAfter": { "Increment_count": ["Succeeded"] },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "UpdateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "accounts",
                  "recordId": "@items('Apply_to_each')?['accountid']",
                  "item/description": "Synced"
                },
                "authentication": "@parameters('$authentication')"
              }
            }
          },
          "runAfter": { "List_accounts": ["Succeeded"] },
          "type": "Foreach"
        },
        "Send_summary": {
          "runAfter": { "Apply_to_each": ["Succeeded"] },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_office365",
              "operationId": "SendEmailV2",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
            },
            "parameters": {
              "emailMessage/To": "admin@contoso.com",
              "emailMessage/Subject": "Sync finished",
              "emailMessage/Body": "<p>@{variables('count')} accounts: @{join(variables('emails'), ', ')}</p>"
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      },
      "outputs": {}
    },
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "connectionName": "shared-commondataser-00000000-0000-4000-8000-000000000201",
        "source": "Embedded",
        "id": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
        "tier": "NotSpecified"
      },
      "shared_office365": {
        "connectionName": "shared-office365-00000000-0000-4000-8000-000000000202",
        "source": "Embedded",
        "id": "/providers/Microsoft.PowerApps/apis/shared_office365",
        "tier": "NotSpecified"
      }
    }
  }
}
